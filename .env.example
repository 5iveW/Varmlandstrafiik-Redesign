# Copy to .env.local and fill in keys from your project at https://developer.trafiklab.se
# Key for "Trafiklab Realtime APIs" (stop search and departures)
TRAFIKLAB_REALTIME_KEY=
# Key for "ResRobot v2.1" (trip planning)
RESROBOT_KEY=
# Keys for "GTFS Regional Realtime" and "GTFS Regional Static" (live bus map)
GTFS_REGIONAL_RT_KEY=
GTFS_REGIONAL_STATIC_KEY=
# Web push for "leave now" reminders. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/5iveW/Varmlandstrafiik-Redesign
# Needed when deployed (Vercel cannot keep timers): Upstash QStash schedules reminders.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public address QStash calls back to. On Vercel the production URL is used if unset.
APP_URL=
